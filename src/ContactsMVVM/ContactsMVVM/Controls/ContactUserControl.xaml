<UserControl x:Class="ContactsMVVM.Controls.ContactUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ContactsMVVM.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="3px"/>
            <Setter Property="VerticalAlignment"  Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip"
                        Value="{Binding RelativeSource={RelativeSource Self},
                        Path=(Validation.Errors)[0].ErrorContent}" />
                    <Setter Property="Foreground" Value="Red" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25px"/>
            <RowDefinition Height="25px"/>
            <RowDefinition Height="25px"/>
            <RowDefinition Height="25px"/>
            <RowDefinition Height="25px"/>
            <RowDefinition Height="25px"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="106px"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Image Width="100px" Height="100px" Grid.Column="0" Grid.Row ="1" Grid.RowSpan="4" VerticalAlignment="Stretch"  Panel.ZIndex="1" Source="/Resources/photo_placeholder.png"/>
        <TextBlock x:Name="ContactNameTextBlock" Text="Name:" Grid.Column="1" Grid.Row="0"/>
        <TextBox x:Name="ContactNameTextBox" Grid.Column="1" Grid.Row="1" 
                 IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=local:ContactUserControl}}">
            <TextBox.Text>
                <Binding Path="Name" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <DataErrorValidationRule />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>
        <TextBlock x:Name="ContactPhoneNumberTextBlock" Text="Phone Number:" Grid.Column="1" Grid.Row="2"/>
        <TextBox x:Name="ContactPhoneNumberTextBox" Grid.Column="1" Grid.Row="3" 
                 IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=local:ContactUserControl}}" PreviewTextInput="ContactPhoneNumberTextBox_PreviewTextInput" DataObject.Pasting="ContactPhoneNumberTextBox_Pasting">
            <TextBox.Text>
                <Binding Path="PhoneNumber" UpdateSourceTrigger="PropertyChanged" >
                    <Binding.ValidationRules>
                        <DataErrorValidationRule/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>
        <TextBlock x:Name="ContactEmailTextBlock" Text="Email:" Grid.Column="1" Grid.Row="4"/>
        <TextBox x:Name="ContactEmailTextBox" Grid.Column="1" Grid.Row="5" 
                 IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=local:ContactUserControl}}">
            <TextBox.Text>
                <Binding Path="Email" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <DataErrorValidationRule/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>
    </Grid>
</UserControl>
