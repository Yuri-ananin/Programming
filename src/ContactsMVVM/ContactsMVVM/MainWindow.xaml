<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Converters="clr-namespace:ContactsMVVM.Model.Services"
        xmlns:ViewModel="clr-namespace:ContactsMVVM.ViewModel" x:Name="MainWindow1" x:Class="ContactsMVVM.MainWindow"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" MinWidth="800" MinHeight="450">
    <Window.DataContext>
        <ViewModel:MainVM/>
    </Window.DataContext>
    <Window.Resources>
        <Style TargetType="ListBox">
            <Setter Property="Margin" Value="8,3,3,3"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3,3,3,8"/>
            <Setter Property="Height" Value="25px"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="VerticalAlignment"  Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>

        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="3,3,8,3"/>
            <Setter Property="VerticalAlignment"  Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Converters:VisibilityConverter x:Key="VisibilityConverter" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="200px"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="250px"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="#f8f8f8">
            <Grid.RowDefinitions>
                <RowDefinition Height="36px"/>
                <RowDefinition/>
                <RowDefinition Height="36px"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="45px"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Find" Grid.Column="0" Text="Find:" Height="19px" Margin="8,3,3,3"/>
                <TextBox x:Name="FindTextBox" Grid.Column="1" VerticalAlignment="Center" Margin="6,0,3,0"/>
            </Grid>
            <ListBox x:Name="ContactsListBox"  Grid.Row="1" ItemsSource="{Binding Contacts}"
                 SelectedItem="{Binding SelectedContact}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5">
                            <TextBlock FontSize="12" FontWeight="Bold" Text="{Binding Path=Name}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid x:Name="ButtonsGrid" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button x:Name="AddButton" Content="Add" Grid.Column="0" Command="{Binding AddCommand}" Margin="8,3,3,8"/>
                <Button x:Name="EditButton" Content="Edit" Grid.Column="1" Command="{Binding EditCommand}"/>
                <Button x:Name="RemoveButton" Content="Remove" Grid.Column="2" Command="{Binding RemoveCommand}"/>
            </Grid>
        </Grid>
        <GridSplitter Grid.Column="1" ShowsPreview="False" Width="3px"
        HorizontalAlignment="Center" VerticalAlignment="Stretch" />
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="30px"/>
                <RowDefinition Height="25px"/>
                <RowDefinition Height="25px"/>
                <RowDefinition Height="25px"/>
                <RowDefinition Height="25px"/>
                <RowDefinition Height="25px"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="106px"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Image Width="100px" Height="100px" Grid.Column="0" Grid.Row ="1" Grid.RowSpan="4" VerticalAlignment="Stretch"  Panel.ZIndex="1" Source="/Resources/photo_placeholder.png"/>
            <TextBlock x:Name="ContactNameTextBlock" Text="Name:" Grid.Column="1" Grid.Row="0" Margin="3,8,3,3"/>
            <TextBox x:Name="ContactNameTextBox" Grid.Column="1" Grid.Row="1" IsReadOnly="{Binding IsReadOnly}" 
                     Text="{Binding Path=SelectedContact.Name, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock x:Name="ContactPhoneNumberTextBlock" Text="Phone Number:" Grid.Column="1" Grid.Row="2"/>
            <TextBox x:Name="ContactPhoneNumberTextBox" Grid.Column="1" Grid.Row="3" IsReadOnly="{Binding IsReadOnly}"
                     Text="{Binding Path=SelectedContact.PhoneNumber, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock x:Name="ContactEmailTextBlock" Text="Email:" Grid.Column="1" Grid.Row="4"/>
            <TextBox x:Name="ContactEmailTextBox" Grid.Column="1" Grid.Row="5" IsReadOnly="{Binding IsReadOnly}"
                     Text="{Binding Path=SelectedContact.Email, UpdateSourceTrigger=PropertyChanged}"/>
            <Button x:Name="ApplyButton" Content="Apply" Height="25px" Width="75px" Grid.Column="1" Grid.Row="6" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Command="{Binding ApplyCommand}" Visibility="{Binding ApplyButtonVisibility, Converter={StaticResource VisibilityConverter}}"/>

        </Grid>
    </Grid>
</Window>